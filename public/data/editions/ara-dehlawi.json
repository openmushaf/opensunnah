{"hadiths":[{"arabicnumber":1,"grades":[],"hadithnumber":1,"reference":{"book":1,"hadith":1},"text":"لَیْسَ الْخَبَرُ کَالْمُعَایَنَةِ"},{"arabicnumber":2,"grades":[],"hadithnumber":2,"reference":{"book":1,"hadith":2},"text":"الْحَرْبُ خُدَعَةٌ"},{"arabicnumber":3,"grades":[],"hadithnumber":3,"reference":{"book":1,"hadith":3},"text":"الْمُسْلِمُ مِرْآةُ الْمُسْلِمِ"},{"arabicnumber":4,"grades":[],"hadithnumber":4,"reference":{"book":1,"hadith":4},"text":"الْمُسْتَشَارُ مُؤتَمَنٌ"},{"arabicnumber":5,"grades":[],"hadithnumber":5,"reference":{"book":1,"hadith":5},"text":"الدَّالُّ عَلَی الْخَیْرِ کَفَاعِلِهِ"},{"arabicnumber":6,"grades":[],"hadithnumber":6,"reference":{"book":1,"hadith":6},"text":"إِسْتَعِیْنُوْا عَلَی الْحَوَائِجِ بِالْکِتْمَانِ"},{"arabicnumber":7,"grades":[],"hadithnumber":7,"reference":{"book":1,"hadith":7},"text":"إِتَّقُوْا النَّارَ وَلَوْ بِشِقِّ تَمْرَةٍ"},{"arabicnumber":8,"grades":[],"hadithnumber":8,"reference":{"book":1,"hadith":8},"text":"الدُّنْیَا سِجْنُ الْمُؤمِنِ وَ جَنَّةُ الْکَافِرِ"},{"arabicnumber":9,"grades":[],"hadithnumber":9,"reference":{"book":1,"hadith":9},"text":"الْحَیَاءُ خَیْرٌ کُلُّهُ"},{"arabicnumber":10,"grades":[],"hadithnumber":10,"reference":{"book":1,"hadith":10},"text":"عِدَةُ الْمُؤمِنِ کَاَخْذِ الْکَفِّ"},{"arabicnumber":11,"grades":[],"hadithnumber":11,"reference":{"book":1,"hadith":11},"text":"لَا یَحِلُّ لِمُؤمِنٍ اَنْ یَّجُهْرَ أخَاهُ فَوقَ ثَلَاثَةِ أیَّامٍ"},{"arabicnumber":12,"grades":[],"hadithnumber":12,"reference":{"book":1,"hadith":12},"text":"لَیْسَ مِنَّا مَنْ غَشَّنَا"},{"arabicnumber":13,"grades":[],"hadithnumber":13,"reference":{"book":1,"hadith":13},"text":"مَا قَلَّ وَكَفَى خَيْرٌ مِمَّا كَثُرَ وَأَلْهَى"},{"arabicnumber":14,"grades":[],"hadithnumber":14,"reference":{"book":1,"hadith":14},"text":"الرَّاجِعُ فِيْ هِبَتِهِ کَالرَّاجِعِ فِيْ قَیْئِهِ"},{"arabicnumber":15,"grades":[],"hadithnumber":15,"reference":{"book":1,"hadith":15},"text":"الْبَلَاءُ مُوَکِّلٌ بِالْمَنْطِقِ"},{"arabicnumber":16,"grades":[],"hadithnumber":16,"reference":{"book":1,"hadith":16},"text":"النَّاسُ کَأسْنَانِ الْمُشْطِ"},{"arabicnumber":17,"grades":[],"hadithnumber":17,"reference":{"book":1,"hadith":17},"text":"الْغِنَى غِنَى النَّفْسِ"},{"arabicnumber":18,"grades":[],"hadithnumber":18,"reference":{"book":1,"hadith":18},"text":"الْسَّعِیْدُ مَنْ وُّعِظَ بِغَیْرِهِ"},{"arabicnumber":19,"grades":[],"hadithnumber":19,"reference":{"book":1,"hadith":19},"text":"وَ إِنَّ مِنَ الشِّعْرِ لَحِکْمَةً وَاِنَّ مِنَ الْبَیَانِ لَسِحْرًا"},{"arabicnumber":20,"grades":[],"hadithnumber":20,"reference":{"book":1,"hadith":20},"text":"عَفْوُ الْمُلُوْكِ إِبْقَاءٌ لِلْمُلْكِ"},{"arabicnumber":21,"grades":[],"hadithnumber":21,"reference":{"book":1,"hadith":21},"text":"اَلْمَرْءُ مَعَ مَنْ أَحَبَّ"},{"arabicnumber":22,"grades":[],"hadithnumber":22,"reference":{"book":1,"hadith":22},"text":"مَا هَلَكَ إمْرُؤٌ عَرَفَ قَدْرَهُ"},{"arabicnumber":23,"grades":[],"hadithnumber":23,"reference":{"book":1,"hadith":23},"text":"اَلْوَلَدُ لِلْفِرَاشِ وَ لِلْعَاهِرِ الْحَجَرُ"},{"arabicnumber":24,"grades":[],"hadithnumber":24,"reference":{"book":1,"hadith":24},"text":"الْیَدُ الْعُلْیَا خَیْرٌ مِّنَ الْیَدِ السُّفْلَی"},{"arabicnumber":25,"grades":[],"hadithnumber":25,"reference":{"book":1,"hadith":25},"text":"لَا شَکَرَ اللهَ مَنْ لَّا یَشْکُرُ النَّاسَ"},{"arabicnumber":26,"grades":[],"hadithnumber":26,"reference":{"book":1,"hadith":26},"text":"حُبُّكَ الشَّيْءَ یُعْمِيْ وَ یُصِمُّ"},{"arabicnumber":27,"grades":[],"hadithnumber":27,"reference":{"book":1,"hadith":27},"text":"جُبِلَتِ الْقُلُوبُ عَلی حُبَّ مَنْ اَحْسَنَ اِلَیْهَا وَ بُغْضِ مَنْ اَسَاءَ اِلَیْهَا"},{"arabicnumber":28,"grades":[],"hadithnumber":28,"reference":{"book":1,"hadith":28},"text":"الْتَّائِبُ مِنَ الذَّنْبِ کَمَنْ لَا ذَنْبَ لَهُ"},{"arabicnumber":29,"grades":[],"hadithnumber":29,"reference":{"book":1,"hadith":29},"text":"الشَّاهِدُ یَرَی مَا لَا یَرَاهُ الْغَائِبُ"},{"arabicnumber":30,"grades":[],"hadithnumber":30,"reference":{"book":1,"hadith":30},"text":"اِذا جَاءَکُمْ کَرِیْمُ قَوْمٍ فَاَکْرِمُوهُ"},{"arabicnumber":31,"grades":[],"hadithnumber":31,"reference":{"book":1,"hadith":31},"text":"الْیَمِینُ الْفَاجِرَةُ تَدَعُ الدِّیَارَ الْبَلَاقِعَ"},{"arabicnumber":32,"grades":[],"hadithnumber":32,"reference":{"book":1,"hadith":32},"text":"مَنْ قُتِلَ دُونَ مَالِهِ فَهُوَ شَهِیْدٌ"},{"arabicnumber":33,"grades":[],"hadithnumber":33,"reference":{"book":1,"hadith":33},"text":"الْاَعْمَالُ بِالنِّیَّةِ"},{"arabicnumber":34,"grades":[],"hadithnumber":34,"reference":{"book":1,"hadith":34},"text":"سَیِّدُ الْقَوْمِ خَادِمُهُمْ"},{"arabicnumber":35,"grades":[],"hadithnumber":35,"reference":{"book":1,"hadith":35},"text":"خَیْرُ الْأُمُوْرِ أَوْسَطُهَا"},{"arabicnumber":36,"grades":[],"hadithnumber":36,"reference":{"book":1,"hadith":36},"text":"اَللَّهُمَّ بَارِكْ فِیْ أُمَّتِیْ فِی بُکُوْرِهَا یَوْمَ الْخَمِیْسِ"},{"arabicnumber":37,"grades":[],"hadithnumber":37,"reference":{"book":1,"hadith":37},"text":"کَادَ الْفَقْرُ أَنْ یَکُوْنَ کُفْرًا"},{"arabicnumber":38,"grades":[],"hadithnumber":38,"reference":{"book":1,"hadith":38},"text":"الْسَّفَرُ قِطْعَةٌ مِّنَ الْعَذَابِ"},{"arabicnumber":39,"grades":[],"hadithnumber":39,"reference":{"book":1,"hadith":39},"text":"خَیْرُ زَّادِ الْتَّقْوَی"},{"arabicnumber":40,"grades":[],"hadithnumber":40,"reference":{"book":1,"hadith":40},"text":"الْمَجَالِسُ بِالْاَمَانَةِ"}],"metadata":{"name":"Forty Hadith of Shah Waliullah Dehlawi","section_details":{"0":{"arabicnumber_first":0,"arabicnumber_last":0,"hadithnumber_first":0,"hadithnumber_last":0},"1":{"arabicnumber_first":1,"arabicnumber_last":40,"hadithnumber_first":1,"hadithnumber_last":40}},"sections":{"0":"","1":"Forty Hadith of Shah Waliullah Dehlawi"}}}